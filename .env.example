# Copy to .env (gitignored) and fill in. Never commit real values.
# Claude Code expands ${STITCH_API_KEY} in .mcp.json from your shell environment,
# so export it (e.g. `set -a; source .env; set +a`) before starting `claude`.
STITCH_API_KEY=

# Flask admin session secret. Any long random string; defaults to a dev-only value.
FIVE_IDEAS_ADMIN_SECRET=

# Optional: checkout of the house_stats parser used by /api/house-stats/parse-url.
HOUSE_STATS_DIR=

# Optional: override where ideas.json, streak.json and ideas.db live (default: ./data).
FIVE_IDEAS_DATA_DIR=
